rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isPublic(doc) {
      return doc.data.privacyLevel == 'public';
    }
    
    function isConnectionsOnly(doc) {
      return doc.data.privacyLevel == 'connections';
    }
    
    function isConnection(userId1, userId2) {
      let connectionId1 = userId1 + '_' + userId2;
      let connectionId2 = userId2 + '_' + userId1;
      return exists(/databases/{database}/documents/connections/$(connectionId1)) ||
             exists(/databases/{database}/documents/connections/$(connectionId2));
    }
    
    // User profiles - readable by anyone, writable only by owner
    match /users/{userId} {
      allow read;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if false; // Don't allow user deletion through client
    }
    
    // Social posts
    match /socialPosts/{postId} {
      // Anyone can read public posts
      allow read: if isPublic(resource);
      
      // Connections can read connections-only posts
      allow read: if isConnectionsOnly(resource) && 
                    (isOwner(resource.data.userId) || 
                     isConnection(request.auth.uid, resource.data.userId));
      
      // Private posts only readable by owner
      allow read: if !isPublic(resource) && 
                    !isConnectionsOnly(resource) && 
                    isOwner(resource.data.userId);
      
      // Only signed-in users can create posts
      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Only post owner can update or delete
      allow update, delete: if isSignedIn() && 
                              isOwner(resource.data.userId);
      
      // Likes subcollection
      match /likes/{likeId} {
        allow read;
        allow create: if isSignedIn() && likeId == request.auth.uid;
        allow delete: if isSignedIn() && likeId == request.auth.uid;
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read;
        allow create: if isSignedIn() && 
                        request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && 
                                isOwner(resource.data.userId);
      }
    }
    
    // Connections between users
    match /connections/{connectionId} {
      allow read: if isSignedIn() && 
                    (isOwner(resource.data.userId) || 
                     isOwner(resource.data.connectionId));
      allow create: if isSignedIn() && 
                      (request.resource.data.userId == request.auth.uid || 
                       request.resource.data.connectionId == request.auth.uid);
      allow update: if isSignedIn() && 
                      (isOwner(resource.data.userId) || 
                       isOwner(resource.data.connectionId));
      allow delete: if isSignedIn() && 
                      (isOwner(resource.data.userId) || 
                       isOwner(resource.data.connectionId));
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && 
                    isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
                      isOwner(resource.data.userId);
      allow delete: if isSignedIn() && 
                      isOwner(resource.data.userId);
    }
    
    // Events collection with privacy controls
    match /events/{eventId} {
      // Public events readable by anyone
      allow read: if resource.data.privacyLevel == 'public' ||
                    !('privacyLevel' in resource.data); // For backward compatibility
      
      // Connections-only events
      allow read: if resource.data.privacyLevel == 'connections' &&
                    (isOwner(resource.data.createdBy) ||
                     isConnection(request.auth.uid, resource.data.createdBy));
      
      // Private events only readable by owner
      allow read: if resource.data.privacyLevel == 'private' &&
                    isOwner(resource.data.createdBy);
      
      // Only authenticated users can create events
      allow create: if isSignedIn();
      
      // Only the creator can update or delete events
      allow update, delete: if isSignedIn() &&
                               request.auth.uid == resource.data.createdBy;
      
      // Attendees subcollection - NEW
      match /attendees/{attendeeId} {
        // Anyone can read attendees
        allow read: if true;
        
        // Only authenticated users can write to attendees
        allow write: if isSignedIn();
      }
    }
    
    // QR code collection
    match /qr_codes/{qrCodeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false; // Don't allow deletion
    }
    
    // Check-ins collection
    match /check_ins/{checkInId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false; // Don't allow updates
      allow delete: if false; // Don't allow deletion
    }
    
    // User Suggestions Collection Rules
    match /userSuggestions/{suggestionId} {
      // Users can only read their own suggestions
      allow read: if request.auth != null && 
                  resource.data.userId == request.auth.uid;
      
      // Only admin users or the system can write to suggestions
      allow write: if request.auth != null && 
                   (request.auth.token.admin == true || 
                    request.auth.token.system == true);
      
      // Validate suggestion data structure
      function isValidSuggestion() {
        let requiredFields = ['userId', 'suggestedUserId', 'score', 'reason', 'createdAt'];
        let data = request.resource.data;
        
        return requiredFields.hasAll(data.keys()) &&
               data.userId is string &&
               data.suggestedUserId is string &&
               data.score is number &&
               data.score >= 0 && data.score <= 1 &&
               data.reason is string &&
               data.createdAt is timestamp;
      }
      
      // Additional validation for create operations
      allow create: if request.auth != null && 
                    request.auth.token.admin == true && 
                    isValidSuggestion();
    }
    
    // Update privacy settings rules to include suggestion controls
    match /privacySettings/{userId} {
      // Allow users to read and write their own privacy settings
      allow read, write: if request.auth != null && 
                          request.auth.uid == userId;
      
      // Validate privacy settings structure
      function isValidPrivacySettings() {
        let data = request.resource.data;
        
        return data.keys().hasAny(['allowRecommendations', 'profileVisibility']) &&
               (!data.keys().hasAny(['allowRecommendations']) || data.allowRecommendations is bool) &&
               (!data.keys().hasAny(['profileVisibility']) || 
                (data.profileVisibility is string && 
                 ['public', 'connections', 'private'].hasAny([data.profileVisibility])));
      }
      
      // Additional validation for update operations
      allow update: if request.auth != null && 
                    request.auth.uid == userId && 
                    isValidPrivacySettings();
    }
    
    // Allow read access to all collections for debugging
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow collection group queries for attendees
    match /{path=**}/attendees/{attendeeId} {
      allow read: if true; // Allow all reads to attendees subcollection
    }
  }
}