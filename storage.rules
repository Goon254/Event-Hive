rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Common helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Default rule - allow read, but not write
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow uploads to events with event ID in the path
    match /events/{userId}/{eventId}/{fileName} {
      allow read, write: if true;
    }
    
    // Allow uploads to event speakers
    match /events/{userId}/{eventId}/speakers/{fileName} {
      allow read, write: if true;
    }
    
    // For testing purposes - allow all operations on these paths
    match /profile_images/{fileName} {
      allow read, write: if true;
    }
    
    match /posts/{userId}/{fileName} {
      allow read, write: if true;
    }
    
    match /events/{userId}/{fileName} {
      allow read, write: if true;
    }
    
    match /test_uploads/{userId}/{fileName} {
      allow read, write: if true;
    }
    
    // More restrictive rules for production use (commented out for now)
    /*
    // Profile images - direct upload to profile_images folder
    match /profile_images/{fileName} {
      // Anyone can read profile images
      allow read: if true;
      
      // Allow authenticated users to upload profile images
      allow write: if isSignedIn();
    }
    
    // Legacy profile images path with userId
    match /profile_images/{userId}/{fileName} {
      // Anyone can read profile images
      allow read: if true;
      
      // Only the owner can write their profile image
      allow write: if isSignedIn() && isOwner(userId);
    }
    
    // Photos path used in UploadImages component
    match /photos/{userId}/{fileName} {
      // Anyone can read user photos
      allow read: if true;
      
      // Only the owner can upload their photos
      allow write: if isSignedIn() && isOwner(userId);
    }
    
    // Post images
    match /posts/{userId}/{postId}/{fileName} {
      // Anyone can read post images
      allow read: if true;
      
      // Only the owner can upload post images
      allow write: if isSignedIn() && isOwner(userId);
    }
    
    // Event images
    match /events/{userId}/{eventId}/{fileName} {
      // Anyone can read event images
      allow read: if true;
      
      // Only the owner can upload event images
      allow write: if isSignedIn() && isOwner(userId);
    }
    
    // Speaker images for events
    match /events/{userId}/{eventId}/speakers/{speakerId}/{fileName} {
      // Anyone can read speaker images
      allow read: if true;
      
      // Only the event owner can upload speaker images
      allow write: if isSignedIn() && isOwner(userId);
    }
    
    // General uploads folder with user isolation
    match /uploads/{userId}/{fileName} {
      // Anyone can read general uploads
      allow read: if true;
      
      // Only the owner can upload to their folder
      allow write: if isSignedIn() && isOwner(userId);
    }
    
    // Test uploads folder for testing Firebase Storage
    match /test_uploads/{userId}/{fileName} {
      // Anyone can read test uploads
      allow read: if true;
      
      // Only the owner can upload to their test folder
      allow write: if isSignedIn() && isOwner(userId);
    }
    */
  }
}
